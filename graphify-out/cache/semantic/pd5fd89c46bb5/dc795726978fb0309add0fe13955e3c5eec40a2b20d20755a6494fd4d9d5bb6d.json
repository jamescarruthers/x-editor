{"nodes": [{"id": "apps_editor_public_favicon_app_icon", "label": "Editor App Favicon (32x32 SVG app icon)", "file_type": "image", "source_file": "apps/editor/public/favicon.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_editor_public_favicon_rounded_square_badge", "label": "Rounded Square Badge (32x32, rx=7, blue fill)", "file_type": "image", "source_file": "apps/editor/public/favicon.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_editor_public_favicon_angle_bracket_glyph", "label": "Outward Angle Bracket Glyph (white chevron pair)", "file_type": "image", "source_file": "apps/editor/public/favicon.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_editor_public_favicon_brand_blue_2563eb", "label": "Brand Blue #2563eb", "file_type": "concept", "source_file": "apps/editor/public/favicon.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "#2563eb is Tailwind's blue-600, the framework default primary. Using the palette token verbatim rather than a bespoke hex keeps the icon in lockstep with in-app accent colours without a shared design-token pipeline."}, {"id": "apps_editor_public_favicon_code_editor_visual_identity", "label": "Code Editor Visual Identity (brackets as product signifier)", "file_type": "rationale", "source_file": "apps/editor/public/favicon.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The mark is a pair of outward-facing angle brackets rather than a wordmark or letterform. Brackets are the near-universal shorthand for source code, so the icon reads as a code/text editor at a glance and stays legible in a browser tab where no accompanying label is visible. It also avoids tying the icon to a product name, so renaming the app does not invalidate the asset."}, {"id": "apps_editor_public_favicon_scalable_vector_favicon", "label": "Scalable Vector Favicon Strategy", "file_type": "rationale", "source_file": "apps/editor/public/favicon.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shipping a single SVG instead of a multi-resolution .ico or a set of PNGs: one ~300-byte file renders crisply at every density and OS icon size, needs no build step or raster pipeline, and can be served straight from the static public/ directory. Trade-off is no support in very old browsers, which is acceptable for a modern web editor."}, {"id": "apps_editor_public_favicon_small_size_legibility", "label": "Small-Size Legibility Constraints (heavy stroke, round caps, max contrast)", "file_type": "rationale", "source_file": "apps/editor/public/favicon.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every drawing choice is tuned for a 16px tab render: stroke-width 2.6 on a 32-unit canvas (~8% of width) survives downscaling where a hairline would vanish; pure white on saturated blue maximises contrast; round line caps and joins prevent mitre spikes from aliasing into noise; fill=none keeps the mark an open figure so the two brackets stay separable."}, {"id": "apps_editor_public_favicon_static_public_asset", "label": "Static public/ Asset Convention", "file_type": "concept", "source_file": "apps/editor/public/favicon.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Living under apps/editor/public/ means the file is copied verbatim to the web root by the bundler and referenced by an absolute /favicon.svg URL from the app's HTML shell, bypassing module hashing so the path stays stable across builds."}], "edges": [{"source": "apps_editor_public_favicon_app_icon", "target": "apps_editor_public_favicon_rounded_square_badge", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/editor/public/favicon.svg", "source_location": null, "weight": 1.0}, {"source": "apps_editor_public_favicon_app_icon", "target": "apps_editor_public_favicon_angle_bracket_glyph", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/editor/public/favicon.svg", "source_location": null, "weight": 1.0}, {"source": "apps_editor_public_favicon_rounded_square_badge", "target": "apps_editor_public_favicon_brand_blue_2563eb", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/editor/public/favicon.svg", "source_location": null, "weight": 1.0}, {"source": "apps_editor_public_favicon_angle_bracket_glyph", "target": "apps_editor_public_favicon_code_editor_visual_identity", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "apps/editor/public/favicon.svg", "source_location": null, "weight": 1.0}, {"source": "apps_editor_public_favicon_code_editor_visual_identity", "target": "apps_editor_public_favicon_app_icon", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "apps/editor/public/favicon.svg", "source_location": null, "weight": 1.0}, {"source": "apps_editor_public_favicon_scalable_vector_favicon", "target": "apps_editor_public_favicon_app_icon", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "apps/editor/public/favicon.svg", "source_location": null, "weight": 1.0}, {"source": "apps_editor_public_favicon_small_size_legibility", "target": "apps_editor_public_favicon_angle_bracket_glyph", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "apps/editor/public/favicon.svg", "source_location": null, "weight": 1.0}, {"source": "apps_editor_public_favicon_small_size_legibility", "target": "apps_editor_public_favicon_brand_blue_2563eb", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "apps/editor/public/favicon.svg", "source_location": null, "weight": 1.0}, {"source": "apps_editor_public_favicon_static_public_asset", "target": "apps_editor_public_favicon_app_icon", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "apps/editor/public/favicon.svg", "source_location": null, "weight": 1.0}, {"source": "apps_editor_public_favicon_scalable_vector_favicon", "target": "apps_editor_public_favicon_static_public_asset", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "apps/editor/public/favicon.svg", "source_location": null, "weight": 1.0}, {"source": "apps_editor_public_favicon_scalable_vector_favicon", "target": "apps_editor_public_favicon_small_size_legibility", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.7, "source_file": "apps/editor/public/favicon.svg", "source_location": null, "weight": 1.0}, {"source": "apps_editor_public_favicon_rounded_square_badge", "target": "apps_editor_public_favicon_code_editor_visual_identity", "relation": "conceptually_related_to", "confidence": "AMBIGUOUS", "confidence_score": 0.25, "source_file": "apps/editor/public/favicon.svg", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "favicon_app_icon_design_system", "label": "Favicon Icon Design: badge, glyph and brand colour forming one mark", "nodes": ["apps_editor_public_favicon_app_icon", "apps_editor_public_favicon_rounded_square_badge", "apps_editor_public_favicon_angle_bracket_glyph", "apps_editor_public_favicon_brand_blue_2563eb"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/editor/public/favicon.svg"}, {"id": "favicon_design_constraint_set", "label": "Favicon Design Constraints: vector delivery, tab-size legibility, static asset path", "nodes": ["apps_editor_public_favicon_scalable_vector_favicon", "apps_editor_public_favicon_small_size_legibility", "apps_editor_public_favicon_static_public_asset", "apps_editor_public_favicon_app_icon"], "relation": "participate_in", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "apps/editor/public/favicon.svg"}]}