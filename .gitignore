node_modules/
dist/
coverage/
*.tsbuildinfo
.DS_Store
# graphify's knowledge graph is committed, so a fresh container has a map without
# rebuilding one. Only the parts that cannot travel are excluded.
#
# Absolute paths belonging to whichever machine last ran the tool.
graphify-out/.graphify_python
graphify-out/.graphify_root
# A 1.8MB rendering of graph.json, regenerated in about a second by
# `graphify export html`. Committing it would roughly quadruple what each
# commit adds, for something derivable from a file already in the tree.
graphify-out/graph.html
# A per-machine token tally, not a fact about the project.
graphify-out/cost.json
# Transient rebuild artifacts. The lock exists only while a rebuild runs, and
# graphify snapshots the previous graph into a date-stamped directory whenever a
# rebuild would discard curated labels — useful locally, noise in history.
graphify-out/.rebuild.lock
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
